    <!-- Subtle Orbital Guide Ring -->
    <path
        android:pathData="M24,6 A18,18 0 1,1 23.9,6"
        android:strokeColor="#223B82F6"
        android:strokeWidth="1.2" />

    <!-- Animated Rocket Group -->
    <group
