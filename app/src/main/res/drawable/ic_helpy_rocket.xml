            android:fillColor="#883B82F6"
            android:pathData="M-2,6 L0,12 L2,6 Z" />

        <!-- Minimalist 2D Vector Rocket Body -->
        <path
            android:name="rocket_body"
            android:fillColor="#FF3B82F6"
            android:pathData="M0,-8 C3.5,-4 4,1 4,5 L-4,5 C-4,1 -3.5,-4 0,-8 Z M-4,2 L-7,6 L-4,5 Z M4,2 L7,6 L4,5 Z" />
    </group>
</vector>
